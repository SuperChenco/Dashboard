---
import AIBriefPanel from '@/components/dashboard/AIBriefPanel.astro';
import BusinessPanel from '@/components/dashboard/BusinessPanel.astro';
import GoalsPanel from '@/components/dashboard/GoalsPanel.astro';
import TodayPanel from '@/components/dashboard/TodayPanel.astro';
import { dashboardAttentionNote } from '@/data/mock/dashboard';
import AppLayout from '@/layouts/AppLayout.astro';

const today = new Intl.DateTimeFormat('zh-CN', {
  timeZone: 'Asia/Shanghai',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  weekday: 'long',
}).format(new Date());
---

<AppLayout title="Today" subtitle={today} eyebrow="CEO Dashboard">
  <section
    class="mb-5 flex items-start gap-3 rounded-panel border border-warning/20 bg-warning-soft px-4 py-3"
    aria-label="需要关注"
  >
    <span
      class="mt-1 size-2 shrink-0 rounded-full bg-warning"
      aria-hidden="true"></span>
    <div>
      <p
        class="text-xs font-semibold tracking-wide text-warning-strong uppercase"
      >
        Attention
      </p>
      <p class="mt-1 text-sm leading-6 text-warning-strong/85">
        {dashboardAttentionNote}
      </p>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-5 xl:grid-cols-12">
    <div class="xl:col-span-7"><TodayPanel /></div>
    <div class="xl:col-span-5"><GoalsPanel /></div>
    <div class="xl:col-span-8"><BusinessPanel /></div>
    <div class="xl:col-span-4"><AIBriefPanel /></div>
  </div>
</AppLayout>

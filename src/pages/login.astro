---
import '@/styles/global.css';

const error = Astro.url.searchParams.get('error');
const nextPath = Astro.url.searchParams.get('next') ?? '/';
if (Astro.locals.authMode === 'local-development') return Astro.redirect('/');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="P_CEO_OS 私人工作区登录" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <title>登录 · P_CEO_OS</title>
  </head>
  <body class="min-h-screen bg-app-sidebar text-app-foreground antialiased">
    <main class="grid min-h-screen place-items-center px-5 py-12">
      <section
        class="w-full max-w-sm rounded-panel border border-app-border bg-white p-7"
      >
        <div class="flex items-center gap-3">
          <span
            class="grid size-9 place-items-center rounded-control bg-app-foreground text-xs font-semibold text-white"
            >PC</span
          >
          <div>
            <h1 class="text-lg font-semibold tracking-tight">P_CEO_OS</h1>
            <p class="text-xs text-app-subtle">Private Owner Workspace</p>
          </div>
        </div>
        <p class="mt-8 text-sm text-app-muted-foreground">
          使用 Owner 邮箱和密码进入。此系统不开放注册。
        </p>
        {
          error && (
            <p
              role="alert"
              class="mt-4 rounded-control border border-danger/20 bg-danger-soft px-3 py-2 text-sm text-danger-strong"
            >
              {error}
            </p>
          )
        }
        <form action="/api/auth/sign-in" method="post" class="mt-6 space-y-4">
          <input type="hidden" name="next" value={nextPath} />
          <label class="block text-sm font-medium">
            Email
            <input
              name="email"
              type="email"
              autocomplete="email"
              required
              class="mt-1.5 h-11 w-full rounded-control border border-app-border px-3 focus-visible:outline-2 focus-visible:outline-offset-1"
            />
          </label>
          <label class="block text-sm font-medium">
            Password
            <input
              name="password"
              type="password"
              autocomplete="current-password"
              required
              class="mt-1.5 h-11 w-full rounded-control border border-app-border px-3 focus-visible:outline-2 focus-visible:outline-offset-1"
            />
          </label>
          <button
            type="submit"
            class="h-11 w-full rounded-control bg-app-foreground text-sm font-medium text-white focus-visible:outline-2 focus-visible:outline-offset-2"
            >Sign In</button
          >
        </form>
      </section>
    </main>
  </body>
</html>

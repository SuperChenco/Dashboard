---
import DataSettings from '@/components/settings/DataSettings';
import AppLayout from '@/layouts/AppLayout.astro';

const cloudEnabled = Astro.locals.authMode === 'supabase';
---

<AppLayout title="Settings" subtitle="数据迁移与个人数据导出" eyebrow="System">
  <DataSettings client:load cloudEnabled={cloudEnabled} />
</AppLayout>

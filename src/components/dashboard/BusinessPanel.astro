---
import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import Progress from '@/components/ui/Progress.astro';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import { businessSummaries } from '@/data/mock/companies';
---

<Card class="p-5 sm:p-6" labelledby="business-panel-title">
  <SectionHeader
    id="business-panel-title"
    title="Business"
    description="三个业务实体的本周状态"
    href="/companies"
  />
  <div class="mt-5 grid gap-3 md:grid-cols-3">
    {
      businessSummaries.map((business) => (
        <article
          class:list={[
            'rounded-panel border px-4 py-4',
            business.isStrategicPriority
              ? 'border-slate-400 bg-slate-50/70'
              : 'border-app-border bg-white',
          ]}
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold text-app-foreground">
                  {business.name}
                </h3>
                {business.isStrategicPriority && (
                  <span
                    class="size-1.5 rounded-full bg-app-foreground"
                    title="长期核心事业"
                  />
                )}
              </div>
              <p class="mt-1 text-xs text-app-muted-foreground">
                {business.currentStatus}
              </p>
            </div>
            <Badge
              status={business.status}
              label={business.isStrategicPriority ? '核心事业' : '本周'}
            />
          </div>
          <p class="mt-4 min-h-10 text-xs leading-5 text-app-muted-foreground">
            {business.weeklyFocus}
          </p>
          <div class="mt-4">
            <Progress
              value={business.progress}
              label={business.progressLabel}
              tone={business.isStrategicPriority ? 'strategic' : 'default'}
            />
          </div>
        </article>
      ))
    }
  </div>
</Card>

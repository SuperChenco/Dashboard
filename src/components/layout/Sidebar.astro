---
import Icon from '@/components/ui/Icon';
import {
  isNavigationItemActive,
  primaryNavigation,
  secondaryNavigation,
} from '@/config/navigation';

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
---

<aside
  class="fixed inset-y-0 left-0 z-30 hidden w-[14.5rem] flex-col border-r border-app-border bg-app-sidebar lg:flex"
  aria-label="主导航"
>
  <a
    href="/"
    class="mx-3 mt-3 flex h-12 items-center gap-3 rounded-control px-3 text-app-foreground transition-colors hover:bg-black/[0.035] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-app-foreground"
  >
    <span
      class="grid size-7 place-items-center rounded-[7px] bg-app-foreground text-[10px] font-semibold tracking-tight text-white"
    >
      PC
    </span>
    <span>
      <span class="block text-sm font-semibold tracking-tight">P_CEO_OS</span>
      <span class="block text-[10px] text-app-subtle">Personal CEO OS</span>
    </span>
  </a>

  <nav class="mt-6 flex-1 overflow-y-auto px-3" aria-label="工作区">
    <p
      class="px-3 pb-2 text-[10px] font-semibold tracking-[0.14em] text-app-subtle uppercase"
    >
      Workspace
    </p>
    <ul class="space-y-0.5">
      {
        primaryNavigation.map((item) => {
          const active = isNavigationItemActive(activePath, item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'group flex h-9 items-center gap-3 rounded-control px-3 text-[13px] font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-app-foreground',
                  active
                    ? 'bg-black/[0.055] text-app-foreground'
                    : 'text-app-muted-foreground hover:bg-black/[0.035] hover:text-app-foreground',
                ]}
              >
                <Icon name={item.icon} className="size-[17px] shrink-0" />
                <span>{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="my-5 border-t border-app-border"></div>
    <ul class="space-y-0.5">
      {
        secondaryNavigation.map((item) => {
          const active = isNavigationItemActive(activePath, item.href);
          return (
            <li>
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'flex h-9 items-center gap-3 rounded-control px-3 text-[13px] font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-app-foreground',
                  active
                    ? 'bg-black/[0.055] text-app-foreground'
                    : 'text-app-muted-foreground hover:bg-black/[0.035] hover:text-app-foreground',
                ]}
              >
                <Icon name={item.icon} className="size-[17px] shrink-0" />
                <span>{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="border-t border-app-border p-3">
    <a
      href="/settings"
      class="flex h-9 items-center gap-3 rounded-control px-3 text-[13px] font-medium text-app-muted-foreground transition-colors hover:bg-black/[0.035] hover:text-app-foreground focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-app-foreground"
    >
      <Icon name="settings" className="size-[17px]" />
      Settings
      <span class="ml-auto text-[10px] text-app-subtle">Mock</span>
    </a>
    <div class="mt-2 flex items-center gap-3 rounded-control px-3 py-2.5">
      <span
        class="grid size-7 place-items-center rounded-full bg-slate-800 text-[10px] font-semibold text-white"
      >
        CX
      </span>
      <span class="min-w-0">
        <span class="block truncate text-xs font-medium text-app-foreground"
          >CEO Workspace</span
        >
        <span class="block truncate text-[10px] text-app-subtle"
          >Phase 2 Local User</span
        >
      </span>
    </div>
  </div>
</aside>

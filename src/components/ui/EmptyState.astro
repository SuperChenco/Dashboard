---
import Badge from './Badge.astro';

interface Props {
  title: string;
  description: string;
  items?: string[];
}

const { title, description, items = [] } = Astro.props;
---

<section
  class="rounded-panel border border-dashed border-app-border bg-app-surface px-6 py-10 sm:px-8"
>
  <Badge label="Phase 1 Mock" />
  <h2 class="mt-5 text-lg font-semibold tracking-tight text-app-foreground">
    {title}
  </h2>
  <p class="mt-2 max-w-2xl text-sm leading-6 text-app-muted-foreground">
    {description}
  </p>
  {
    items.length > 0 && (
      <ul class="mt-6 grid gap-2 text-sm text-app-muted-foreground sm:grid-cols-2">
        {items.map((item) => (
          <li class="flex items-start gap-2 rounded-control border border-app-border bg-white px-3 py-2.5">
            <span
              class="mt-1.5 size-1.5 shrink-0 rounded-full bg-app-foreground/45"
              aria-hidden="true"
            />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    )
  }
</section>

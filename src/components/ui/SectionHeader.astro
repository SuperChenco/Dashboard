---
interface Props {
  id: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { id, title, description, href, linkLabel = '查看全部' } = Astro.props;
---

<header class="flex items-start justify-between gap-4">
  <div>
    <h2
      id={id}
      class="text-sm font-semibold tracking-tight text-app-foreground"
    >
      {title}
    </h2>
    {
      description && (
        <p class="mt-1 text-xs leading-5 text-app-muted-foreground">
          {description}
        </p>
      )
    }
  </div>
  {
    href && (
      <a
        href={href}
        class="shrink-0 text-xs font-medium text-app-muted-foreground transition-colors hover:text-app-foreground"
      >
        {linkLabel}
      </a>
    )
  }
</header>
